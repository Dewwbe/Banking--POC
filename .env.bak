# Copy to .env and replace every CHANGE_ME value.
# Generate secrets with:  ./scripts/generate-secrets.sh >> .env
# Never commit .env. Production secrets belong in a secret manager (see docs/05-security-checklist.md).

# ---------- Environment ----------
NODE_ENV=development
POC_ENVIRONMENT=dev            # dev | uat | prod (used in audit entries and Content movement tests)

# ---------- Database ----------
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=CHANGE_ME
DATABASE_SSL=false

# ---------- Strapi core secrets ----------
APP_KEYS=CHANGE_ME1,CHANGE_ME2,CHANGE_ME3,CHANGE_ME4
API_TOKEN_SALT=CHANGE_ME
ADMIN_JWT_SECRET=CHANGE_ME
TRANSFER_TOKEN_SALT=CHANGE_ME
JWT_SECRET=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME

# ---------- Server ----------
PUBLIC_URL=http://localhost:1337
IS_PROXIED=false
# Comma-separated list of origins allowed by CORS (the Next.js site only)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---------- Admin session / login hardening ----------
ADMIN_SESSION_MAX_LIFESPAN_SECONDS=28800        # 8h absolute session
ADMIN_REFRESH_MAX_LIFESPAN_SECONDS=86400        # 24h
ADMIN_LOGIN_RATE_LIMIT_MAX=5                   # attempts per interval
ADMIN_LOGIN_RATE_LIMIT_INTERVAL_MS=60000

# ---------- Uploads ----------
UPLOAD_PROVIDER=local          # local | s3
UPLOAD_MAX_FILE_SIZE_MB=10
S3_ACCESS_KEY_ID=minioadmin
S3_ACCESS_SECRET=CHANGE_ME_MINIO
S3_REGION=us-east-1
S3_BUCKET=strapi-media
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000/strapi-media

# ---------- GraphQL (Workstream E: test permissions with it enabled and disabled) ----------
GRAPHQL_ENABLED=false

# ---------- PoC workflow prototype (Workstream C) ----------
WORKFLOW_ENFORCEMENT=true                  # false = observe native Community behaviour only
WORKFLOW_SUPERADMIN_OVERRIDE=false         # true = Super Admin may bypass approval (logged)
WORKFLOW_BLOCK_CONTENT_API_DRAFTS=true     # false = observe native ?status=draft behaviour
PREVIEW_TOKEN_NAME=nextjs-preview          # API token name allowed to read drafts (preview only)

# ---------- Custom scheduling (NOT native Releases) ----------
CUSTOM_SCHEDULER_ENABLED=true
CUSTOM_SCHEDULER_CRON=*/1 * * * *

# ---------- Seeding ----------
SEED_SAMPLE_CONTENT=true
SEED_TEST_USERS=true
SEED_SUPERADMIN_EMAIL=admin@poc.local
SEED_SUPERADMIN_PASSWORD=CHANGE_ME_Adm1n!Pass
SEED_TEST_USER_PASSWORD=CHANGE_ME_Str0ng!Pass

# ---------- Webhook → Next.js revalidation ----------
REVALIDATE_SECRET=CHANGE_ME
NEXT_REVALIDATE_URL=http://web:3000/api/revalidate

# ---------- Next.js ----------
STRAPI_URL=http://localhost:1337
STRAPI_PUBLIC_MEDIA_URL=http://localhost:1337
STRAPI_READ_TOKEN=             # read-only API token created in Strapi (Settings → API Tokens)
NEXT_DEFAULT_REVALIDATE_SECONDS=300
