{
  "kind": "singleType",
  "collectionName": "about_us",
  "info": {
    "singularName": "about-us",
    "pluralName": "about-uses",
    "displayName": "About Us",
    "description": "About the bank"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "introduction": {
      "type": "blocks",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "mission": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "values": {
      "type": "component",
      "repeatable": true,
      "component": "shared.card",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "shared.banner",
        "sections.card-group",
        "sections.faq-group",
        "sections.cta-block",
        "sections.rich-text",
        "sections.legal-notice"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "workflowStage": {
      "type": "enumeration",
      "enum": [
        "draft",
        "in_review",
        "changes_requested",
        "awaiting_approval",
        "approved"
      ],
      "default": "draft",
      "required": true,
      "private": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "reviewComment": {
      "type": "text",
      "private": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "submittedBy": {
      "type": "string",
      "private": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "reviewedBy": {
      "type": "string",
      "private": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "approvedBy": {
      "type": "string",
      "private": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "approvedAt": {
      "type": "datetime",
      "private": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "approvedHash": {
      "type": "string",
      "private": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}