{
  "kind": "singleType",
  "collectionName": "home",
  "info": {
    "singularName": "home",
    "pluralName": "homes",
    "displayName": "Home",
    "description": "Home page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "shared.banner",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "featuredProducts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product.product"
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "shared.banner",
        "sections.card-group",
        "sections.faq-group",
        "sections.cta-block",
        "sections.rich-text",
        "sections.legal-notice"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "workflowStage": {
      "type": "enumeration",
      "enum": [
        "draft",
        "in_review",
        "changes_requested",
        "awaiting_approval",
        "approved"
      ],
      "default": "draft",
      "required": true,
      "private": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "reviewComment": {
      "type": "text",
      "private": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "submittedBy": {
      "type": "string",
      "private": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "reviewedBy": {
      "type": "string",
      "private": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "approvedBy": {
      "type": "string",
      "private": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "approvedAt": {
      "type": "datetime",
      "private": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "approvedHash": {
      "type": "string",
      "private": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}