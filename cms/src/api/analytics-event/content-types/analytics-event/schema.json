{
  "kind": "collectionType",
  "collectionName": "analytics_events",
  "info": {
    "singularName": "analytics-event",
    "pluralName": "analytics-events",
    "displayName": "Analytics event",
    "description": "Anonymous page views and CTA clicks sent by the website. No IP address, cookie or personal data is stored."
  },
  "options": { "draftAndPublish": false },
  "pluginOptions": {
    "content-manager": { "visible": false },
    "content-type-builder": { "visible": false }
  },
  "attributes": {
    "kind": { "type": "enumeration", "enum": ["pageview", "cta_click"], "required": true },
    "day": { "type": "string", "required": true },
    "path": { "type": "string", "required": true },
    "pageTitle": { "type": "string" },
    "section": { "type": "string" },
    "language": { "type": "string" },
    "sessionId": { "type": "string" },
    "ctaId": { "type": "string" },
    "ctaLabel": { "type": "string" },
    "ctaUrl": { "type": "string" },
    "keyConversion": { "type": "boolean", "default": false }
  }
}
